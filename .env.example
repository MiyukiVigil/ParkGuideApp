# ==========================================
# ParkGuideApp Environment Configuration
# ==========================================
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file with credentials

# ==========================================
# Expo & Application Configuration
# ==========================================
# Get from https://expo.dev/
EXPO_PROJECT_ID=your_expo_project_id_here

# Application identifiers
PACKAGE_NAME=com.miyukivigil.parkguideapp
IOS_BUNDLE_ID=com.miyukivigil.parkguideapp

# ==========================================
# Backend API Configuration
# ==========================================
# Backend server URL
API_BASE_URL=http://localhost:8000/api
# Optional: force passkey/WebAuthn endpoints to a different backend host
PASSKEY_API_BASE_URL=https://sfc-parkguidebackend-g3epa6bjcpf9hqez.malaysiawest-01.azurewebsites.net/api
# Optional: explicit host for Android app links / passkey domain association
ASSOCIATED_WEB_HOST=sfc-parkguidebackend-g3epa6bjcpf9hqez.malaysiawest-01.azurewebsites.net

# Dashboard URLs (used by WebView in dashboard.js)
DASHBOARD_BASE_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:8000/dashboard/
SSO_URL=http://localhost:8000/dashboard/sso/

# ==========================================
# Firebase Configuration
# ==========================================
# Get from your Firebase project's google-services.json or Firebase Console
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PROJECT_NUMBER=your_firebase_project_number
FIREBASE_STORAGE_BUCKET=your_firebase_project.firebasestorage.app
FIREBASE_ANDROID_APP_ID=1:YOUR_PROJECT_NUMBER:android:YOUR_ANDROID_APP_ID

# ==========================================
# Third-Party Services Configuration
# ==========================================
# Avatar API (Dicebear) - for user profile pictures
AVATAR_API_URL=https://api.dicebear.com/7.x/avataaars/png
# Default avatar seed - can be overridden per user
DEFAULT_AVATAR_SEED=default

# Google Maps API Keys
GOOGLE_MAPS_API_KEY_ANDROID=your_google_maps_api_key_android
GOOGLE_MAPS_API_KEY_IOS=your_google_maps_api_key_ios

# ==========================================
# Default User Profile (for development/testing)
# ==========================================
# IMPORTANT: These should NOT be used in production
DEFAULT_USER_NAME=Test User
DEFAULT_USER_EMAIL=test@example.com
DEFAULT_USER_PHONE=+60 1234 5678
DEFAULT_USER_ROLE=Park Guide

# Default password for development (NEVER use in production)
DEFAULT_PASSWORD=12345678

# ==========================================
# Environment Configuration
# ==========================================
# Set to 'development' or 'production'
NODE_ENV=development

# ==========================================
# Feature Flags (optional)
# ==========================================
# Enable/disable features per environment
ENABLE_MOCK_AUTH=true
ENABLE_NOTIFICATIONS=true
