{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "GOOGLE_MAPS_API_KEY_ANDROID": "GOOGLE_MAPS_API_KEY_ANDROID",
        "GOOGLE_MAPS_API_KEY_IOS": "GOOGLE_MAPS_API_KEY_IOS"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "GOOGLE_MAPS_API_KEY_ANDROID": "GOOGLE_MAPS_API_KEY_ANDROID",
        "GOOGLE_MAPS_API_KEY_IOS": "GOOGLE_MAPS_API_KEY_IOS"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "GOOGLE_MAPS_API_KEY_ANDROID": "GOOGLE_MAPS_API_KEY_ANDROID",
        "GOOGLE_MAPS_API_KEY_IOS": "GOOGLE_MAPS_API_KEY_IOS"
      }
    }
  },
  "submit": {
    "production": {}
  }
}